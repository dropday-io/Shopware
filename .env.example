# Shopware version tag for dockware/shopware
# Examples: 6.6-latest, 6.7-latest, 6.6.10.0
SHOPWARE_VERSION=6.6-latest

# Host ports
SHOPWARE_PORT=8080
ADMINER_PORT=8888

# Optional Dropday credentials (applied on container boot via boot_end.sh)
# Get these from https://dropday.io/dashboard
DROPDAY_ACCOUNT_ID=
DROPDAY_API_KEY=
# Leave empty to keep the plugin default; set to override on boot
DROPDAY_BASE_URL=
DROPDAY_LIVE_MODE=
