# Shopware Development Environment
# Copy this file to .env and customize for your setup

# Shopware Version for Docker (use full version, e.g., 6.6.6.0, 6.5.8.0)
# See available tags: https://hub.docker.com/r/dockware/dev/tags
SHOPWARE_VERSION=6.6.6.0

# Database (Docker)
DATABASE_URL=mysql://shopware:shopware@database:3306/shopware

# Dropday API (for testing)
# Get your credentials at https://dropday.io/dashboard
DROPDAY_API_KEY=your-api-key-here
DROPDAY_ACCOUNT_ID=your-account-id-here

