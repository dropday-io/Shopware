<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Dropday API Client -->
        <service id="Dropday\DropdayIntegration\Service\DropdayApiClient">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Order Transformer -->
        <service id="Dropday\DropdayIntegration\Service\OrderTransformer">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <!-- Order Sync Service -->
        <service id="Dropday\DropdayIntegration\Service\OrderSyncService">
            <argument type="service" id="Dropday\DropdayIntegration\Service\DropdayApiClient"/>
            <argument type="service" id="Dropday\DropdayIntegration\Service\OrderTransformer"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <!-- Order State Change Subscriber -->
        <service id="Dropday\DropdayIntegration\Subscriber\OrderStateChangeSubscriber">
            <argument type="service" id="Dropday\DropdayIntegration\Service\OrderSyncService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Admin API Controller -->
        <service id="Dropday\DropdayIntegration\Controller\Api\DropdayController" public="true">
            <argument type="service" id="Dropday\DropdayIntegration\Service\DropdayApiClient"/>
            <argument type="service" id="Dropday\DropdayIntegration\Service\OrderSyncService"/>
            <argument type="service" id="order.repository"/>
        </service>
    </services>
</container>

