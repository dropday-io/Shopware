<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="true"/>

        <service id="Dropday\Shopware\Api\DropdayApiClient">
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Dropday\Shopware\Service\OrderPayloadMapper">
            <argument type="service" id="product.repository"/>
        </service>

        <service id="Dropday\Shopware\Flow\SendOrderToDropdayAction">
            <argument type="service" id="Dropday\Shopware\Service\OrderPayloadMapper"/>
            <argument type="service" id="Dropday\Shopware\Api\DropdayApiClient"/>
            <argument type="service" id="order.repository"/>
            <tag name="flow.action" key="action.dropday.send.order"/>
        </service>
    </services>
</container>
